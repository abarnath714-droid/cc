# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Optional initial administrator email for automatic admin role assignment via Google Sign-In.
ADMIN_EMAIL=

# ADMIN_PASSCODE: Optional server-side passcode for creating or unlocking an administrator account.
ADMIN_PASSCODE=
